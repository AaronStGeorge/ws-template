# Activates the workspace virtualenv (creating it on first entry), performs the
# editable install described in README.md, then builds the imp tools into
# build/bin and puts them on PATH.
# Codex discovers the repo's MCP server from .codex/config.toml; no global
# registration or installed Codex executable is needed during shell setup.

if [ "${HRX_KERNELS_WS_SKIP_VENV:-0}" != "1" ]; then
  if [ ! -f "$PWD/.venv/bin/activate" ]; then
    "${PYTHON:-python3}" -m venv "$PWD/.venv" --prompt "${PWD##*/}"
  fi

  source "$PWD/.venv/bin/activate"

  # Editable install of the shared library (agent-tools: buildlib, builds,
  # threadlib and its MCP dependencies), per README.md. Guarded on
  # importability of the newest package so it runs once on a fresh venv, again
  # when a package is added, and is skipped on every other cd.
  if ! python -c "import buildlib, threadlib.mcp" 2>/dev/null; then
    pip install -e "$PWD/lib/python" --config-settings editable_mode=compat
  fi
fi

# imp tools: build/bin/{impd,impctl} from tools/, and on PATH so `impctl`
# resolves bare (the fix imp arms its reconcile Watch with `impctl watch --once`).
# Go's incrementality makes the rebuild ~0.4 s, cheap enough for every cd
if [ ! -f "$PWD/build/build.ninja" ]; then
  cmake -S "$PWD" -B "$PWD/build" -G Ninja
fi
cmake --build "$PWD/build" --parallel
PATH_add build/bin
