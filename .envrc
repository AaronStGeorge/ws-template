# Activates the workspace virtualenv (creating it on first entry), performs the
# editable install described in README.md, then builds the imp tools into
# build/bin and puts them on PATH.

if [ "${HRX_KERNELS_WS_SKIP_VENV:-0}" != "1" ]; then
  if [ ! -f "$PWD/.venv/bin/activate" ]; then
    "${PYTHON:-python3}" -m venv "$PWD/.venv" --prompt "${PWD##*/}"
  fi

  source "$PWD/.venv/bin/activate"

  # Editable install of the shared library (agent-tools: assemblyline, buildlib,
  # builds), per README.md. Guarded on importability so it runs once on a fresh
  # venv and is skipped on subsequent directory entries (.envrc runs on every cd).
  if ! python -c "import buildlib" 2>/dev/null; then
    pip install -e "$PWD/lib/python" --config-settings editable_mode=compat
  fi
fi

# imp tools: build/bin/{impd,impctl,impwatch} from tools/, and on PATH so
# `impwatch` resolves bare (the fix imp arms its reconcile watch with it).
# Go's incrementality makes the rebuild ~0.4 s, cheap enough for every cd
if [ ! -f "$PWD/build/build.ninja" ]; then
  cmake -S "$PWD" -B "$PWD/build" -G Ninja
fi
cmake --build "$PWD/build" --parallel
PATH_add build/bin
